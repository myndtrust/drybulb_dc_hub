# Site
NEXT_PUBLIC_SITE_URL=https://www.drybulb.com

# Contact form (sends inquiries via the Resend REST API)
# RESEND_API_KEY=          # https://resend.com/api-keys
# CONTACT_TO_EMAIL=        # where inquiries are delivered, e.g. hello@drybulb.com
# CONTACT_FROM_EMAIL=      # a verified sender on your Resend domain, e.g. forms@drybulb.com

# Newsletter signup (adds contacts to a Resend Audience; reuses RESEND_API_KEY)
# RESEND_AUDIENCE_ID=      # create an Audience in Resend and copy its ID

# Analytics: Umami website ID is hardcoded in components/shared/analytics.tsx
# (it's a public client-side ID, not a secret) and only loads in production.

# Auth (Phase 2 — choose one provider)
# --- Auth.js / NextAuth v5 ---
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# --- Clerk ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# --- Supabase ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Database (Phase 2)
# DATABASE_URL=        # Neon or Supabase Postgres connection string

# Jobs feed (published to GCS by the scrapers/ Cloud Run Job; read by the frontend)
# Always points at the "latest" pointer object; dated history lives under archive/.
NEXT_PUBLIC_JOBS_FEED_URL=https://storage.googleapis.com/drybulb-jobs/latest.json
